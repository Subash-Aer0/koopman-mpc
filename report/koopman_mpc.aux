\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Hankel test on the training inputs (\texttt  {koopman/excitation.py}). \textsf  {K-Res}{}: $u_d$, data set \texttt  {20261107T182512Z\_datagen\_model1}, recorded in run \texttt  {20261119T152936Z\_edmd\_model1}. \textsf  {K-Full}{}: $\delta u$, data set \texttt  {20261118T192413Z\_outer\_loop\_data}.}}{6}{table.2}\protected@file@percent }
\newlabel{tab:pe}{{2}{6}{Hankel test on the training inputs (\texttt {koopman/excitation.py}). \KRes {}: $u_d$, data set \texttt {20261107T182512Z\_datagen\_model1}, recorded in run \texttt {20261119T152936Z\_edmd\_model1}. \KFull {}: $\delta u$, data set \texttt {20261118T192413Z\_outer\_loop\_data}}{table.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Reading the results.}{6}{section*.12}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Checks before fitting, for the lifted model with $N$ states. $l = 7$: input and wind channels $[u; v_w]$; $m_i = 140$: samples per episode; $m$: snapshot pairs over all episodes. Hankel matrix of depth $N+1$, built as a mosaic: every window lies inside one episode, so each episode needs $m_i \ge N+1$, and the windows of all episodes are pooled to reach full row rank. One episode alone would need $(l+1)(N+1) - 1 = 447$ and $495$ samples, so only the mosaic is PE. At order $n+1$, where Willems' lemma strictly applies, the input is also PE ($70/70$, $91/91$) and the unlifted $[X; U; W]$ has full rank $n + l$ ($16$, $19$).}}{7}{table.3}\protected@file@percent }
\newlabel{tab:gamma-rank}{{3}{7}{Checks before fitting, for the lifted model with $N$ states. $l = 7$: input and wind channels $[u; v_w]$; $m_i = 140$: samples per episode; $m$: snapshot pairs over all episodes. Hankel matrix of depth $N+1$, built as a mosaic: every window lies inside one episode, so each episode needs $m_i \ge N+1$, and the windows of all episodes are pooled to reach full row rank. One episode alone would need $(l+1)(N+1) - 1 = 447$ and $495$ samples, so only the mosaic is PE. At order $n+1$, where Willems' lemma strictly applies, the input is also PE ($70/70$, $91/91$) and the unlifted $[X; U; W]$ has full rank $n + l$ ($16$, $19$)}{table.3}{}}
